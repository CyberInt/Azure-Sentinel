{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Cyberint Argos - Base",
        "description": "This playbook deploys a Key Vault to store the Argos API token and provides a callable workflow that retrieves the token for use by dependent playbooks (Inbound Sync, Outbound Sync, Manual Status Update, Fetch Attachments).",
        "prerequisites": [
            "1. A valid Check Point Cyberint (Argos) API token.",
            "2. The Argos API base URL for your environment."
        ],
        "postDeployment": [
            "No manual steps required. The RBAC role assignment is created automatically during deployment."
        ],
        "lastUpdateTime": "2026-02-17T00:00:00.000Z",
        "entities": [],
        "tags": [ "Utilities" ],
        "support": {
            "tier": "Partner",
            "name": "Cyberint",
            "link": "https://cyberint.com/customer-support/"
        },
        "source": {
            "type": "solution",
            "name": "Check Point Cyberint Alerts"
        },
        "author": {
            "name": "Cyberint"
        },
        "releaseNotes": [
            {
                "version": "1.0.0",
                "title": "Cyberint Argos - Base",
                "notes": [ "Initial version" ]
            }
        ]
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "Cyberint_Base",
            "minLength": 1,
            "metadata": {
                "description": "Name of the Logic App / Playbook"
            }
        },
        "KeyVaultName": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Name of the Key Vault to create. Leave blank to auto-generate a unique name."
            }
        },
        "ArgosApiToken": {
            "type": "securestring",
            "metadata": {
                "description": "Check Point Cyberint (Argos) API token"
            }
        },
        "ArgosBaseUrl": {
            "type": "string",
            "metadata": {
                "description": "Argos API base URL (e.g. https://app.cyberint.io)"
            }
        }
    },
    "variables": {
        "keyVaultName": "[if(empty(parameters('KeyVaultName')), format('Cyberint-{0}', uniqueString(resourceGroup().id)), parameters('KeyVaultName'))]",
        "keyvaultConnectionName": "[concat('Keyvault-', parameters('PlaybookName'))]",
        "argosTokenSecretName": "ArgosApiToken",
        "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6"
    },
    "resources": [
        {
            "type": "Microsoft.KeyVault/vaults",
            "apiVersion": "2021-11-01-preview",
            "name": "[variables('keyVaultName')]",
            "location": "[resourceGroup().location]",
            "properties": {
                "tenantId": "[subscription().tenantId]",
                "enableRbacAuthorization": true,
                "sku": {
                    "family": "A",
                    "name": "standard"
                }
            }
        },
        {
            "type": "Microsoft.KeyVault/vaults/secrets",
            "apiVersion": "2021-11-01-preview",
            "name": "[format('{0}/{1}', variables('keyVaultName'), variables('argosTokenSecretName'))]",
            "properties": {
                "value": "[parameters('ArgosApiToken')]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
            ]
        },
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2018-07-01-preview",
            "name": "[variables('keyvaultConnectionName')]",
            "location": "[resourceGroup().location]",
            "properties": {
                "displayName": "[variables('keyvaultConnectionName')]",
                "parameterValueType": "Alternative",
                "alternativeParameterValues": {
                    "vaultName": "[variables('keyVaultName')]"
                },
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/keyvault')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "tags": {
                "hidden-SentinelTemplateName": "Cyberint_Base",
                "hidden-SentinelTemplateVersion": "1.0"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('keyvaultConnectionName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "ArgosBaseUrl": {
                            "defaultValue": "",
                            "type": "String"
                        }
                    },
                    "triggers": {
                        "manual": {
                            "type": "Request",
                            "kind": "Http",
                            "inputs": {}
                        }
                    },
                    "actions": {
                        "Get_secret_-_Argos_API_Token": {
                            "runAfter": {},
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['keyvault']['connectionId']"
                                    }
                                },
                                "method": "get",
                                "path": "[concat('/secrets/@{encodeURIComponent(''', variables('argosTokenSecretName'), ''')}/value')]"
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [
                                        "inputs",
                                        "outputs"
                                    ]
                                }
                            }
                        },
                        "Response": {
                            "runAfter": {
                                "Get_secret_-_Argos_API_Token": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Response",
                            "kind": "Http",
                            "inputs": {
                                "statusCode": 200,
                                "body": {
                                    "ArgosApiToken": "@{body('Get_secret_-_Argos_API_Token')?['value']}",
                                    "ArgosBaseUrl": "@{parameters('ArgosBaseUrl')}"
                                }
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [
                                        "inputs"
                                    ]
                                }
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "keyvault": {
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/keyvault')]",
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('keyvaultConnectionName'))]",
                                "connectionName": "[variables('keyvaultConnectionName')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    },
                    "ArgosBaseUrl": {
                        "value": "[parameters('ArgosBaseUrl')]"
                    }
                }
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "scope": "[format('Microsoft.KeyVault/vaults/{0}', variables('keyVaultName'))]",
            "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId')))]",
            "properties": {
                "description": "[format('Grants {0} Key Vault Secrets User access to {1}', parameters('PlaybookName'), variables('keyVaultName'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'full').identity.principalId]",
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]",
                "principalType": "ServicePrincipal"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]",
                "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
            ]
        }
    ],
    "outputs": {
        "keyVaultName": {
            "type": "string",
            "value": "[variables('keyVaultName')]"
        },
        "logicAppName": {
            "type": "string",
            "value": "[parameters('PlaybookName')]"
        },
        "logicAppResourceId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
        }
    }
}
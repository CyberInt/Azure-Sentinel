{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Cyberint Argos - Automation Rules for Bi-Directional Sync",
        "description": "Deploys automation rules that trigger the Outbound Sync playbook when Sentinel incident status changes. Includes tag-based loop prevention to avoid circular sync.",
        "prerequisites": [
            "1. Cyberint_OutboundSync playbook must be deployed in the same resource group.",
            "2. Microsoft Sentinel must be enabled on the target Log Analytics workspace."
        ],
        "postDeployment": [
            "1. Verify the automation rules are visible in Microsoft Sentinel > Automation.",
            "2. Grant the Cyberint_OutboundSync playbook Managed Identity the Microsoft Sentinel Responder role if not already done."
        ],
        "lastUpdateTime": "2026-02-17T00:00:00.000Z",
        "entities": [],
        "tags": [ "Sync", "Automation" ],
        "support": {
            "tier": "Partner",
            "name": "Cyberint",
            "link": "https://cyberint.com/customer-support/"
        },
        "source": {
            "type": "solution",
            "name": "Check Point Cyberint Alerts"
        },
        "author": {
            "name": "Cyberint"
        },
        "releaseNotes": [
            {
                "version": "1.0.0",
                "title": "Cyberint Argos - Automation Rules",
                "notes": [ "Initial version" ]
            }
        ]
    },
    "parameters": {
        "SentinelWorkspaceResourceId": {
            "type": "string",
            "metadata": {
                "description": "Full resource ID of the Log Analytics workspace with Microsoft Sentinel enabled (e.g., /subscriptions/.../resourceGroups/.../providers/Microsoft.OperationalInsights/workspaces/...)"
            }
        },
        "OutboundSyncPlaybookName": {
            "type": "string",
            "defaultValue": "Cyberint_OutboundSync",
            "metadata": {
                "description": "Name of the Cyberint_OutboundSync Logic App"
            }
        },
        "AutomationRuleOrder": {
            "type": "int",
            "defaultValue": 100,
            "metadata": {
                "description": "Execution order of the automation rule (lower = higher priority)"
            }
        }
    },
    "variables": {
        "outboundSyncRuleName": "[guid('Cyberint-OutboundSync-Rule', parameters('SentinelWorkspaceResourceId'))]"
    },
    "resources": [
        {
            "type": "Microsoft.SecurityInsights/automationRules",
            "name": "[variables('outboundSyncRuleName')]",
            "scope": "[parameters('SentinelWorkspaceResourceId')]",
            "apiVersion": "2023-02-01-preview",
            "properties": {
                "displayName": "Cyberint - Sync incident status to Argos on update",
                "order": "[parameters('AutomationRuleOrder')]",
                "triggeringLogic": {
                    "isEnabled": true,
                    "triggersOn": "Incidents",
                    "triggersWhen": "Updated",
                    "conditions": []
                },
                "actions": [
                    {
                        "order": 1,
                        "actionType": "RunPlaybook",
                        "actionConfiguration": {
                            "logicAppResourceId": "[resourceId('Microsoft.Logic/workflows', parameters('OutboundSyncPlaybookName'))]",
                            "tenantId": "[subscription().tenantId]"
                        }
                    }
                ]
            }
        }
    ],
    "outputs": {
        "automationRuleId": {
            "type": "string",
            "value": "[variables('outboundSyncRuleName')]"
        }
    }
}
{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Cyberint Argos - Outbound Sync (Sentinel → Argos)",
        "description": "When a Sentinel incident status changes, this playbook pushes the update to the corresponding Argos alert(s). Includes tag-based loop prevention to avoid circular sync with Inbound Sync.",
        "prerequisites": [
            "1. Cyberint_Base playbook must be deployed in the same resource group.",
            "2. The Logic App Managed Identity must be granted Microsoft Sentinel Responder role on the resource group."
        ],
        "postDeployment": [
            "1. Grant the Logic App Managed Identity the **Microsoft Sentinel Responder** role.",
            "2. Configure an automation rule in Microsoft Sentinel to trigger this playbook on incident status changes."
        ],
        "lastUpdateTime": "2026-02-17T00:00:00.000Z",
        "entities": [],
        "tags": [ "Sync", "Incident Update" ],
        "support": {
            "tier": "Partner",
            "name": "Cyberint",
            "link": "https://cyberint.com/customer-support/"
        },
        "source": {
            "type": "solution",
            "name": "Check Point Cyberint Alerts"
        },
        "author": {
            "name": "Cyberint"
        },
        "releaseNotes": [
            {
                "version": "1.0.0",
                "title": "Cyberint Argos - Outbound Sync",
                "notes": [ "Initial version" ]
            }
        ]
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "Cyberint_OutboundSync",
            "metadata": {
                "description": "Name of the Logic App / Playbook"
            }
        },
        "Cyberint_Base_Playbook_Name": {
            "type": "string",
            "defaultValue": "Cyberint_Base",
            "metadata": {
                "description": "Name of the Cyberint_Base playbook (must be deployed first)"
            }
        }
    },
    "variables": {
        "AzureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('AzureSentinelConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('AzureSentinelConnectionName')]",
                "customParameterValues": {},
                "parameterValueType": "Alternative",
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "tags": {
                "hidden-SentinelTemplateName": "Cyberint_OutboundSync",
                "hidden-SentinelTemplateVersion": "1.0"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        }
                    },
                    "triggers": {
                        "Microsoft_Sentinel_incident": {
                            "type": "ApiConnectionWebhook",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "body": {
                                    "callback_url": "@{listCallbackUrl()}"
                                },
                                "path": "/incident-creation"
                            }
                        }
                    },
                    "actions": {
                        "Initialize_variable_-_SyncResults": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "SyncResults",
                                        "type": "string",
                                        "value": ""
                                    }
                                ]
                            },
                            "runAfter": {}
                        },
                        "Initialize_variable_-_AlertRefId": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "AlertRefId",
                                        "type": "string",
                                        "value": ""
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_variable_-_SyncResults": [ "Succeeded" ]
                            }
                        },
                        "Initialize_variable_-_ArgosStatus": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "ArgosStatus",
                                        "type": "string",
                                        "value": ""
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_variable_-_AlertRefId": [ "Succeeded" ]
                            }
                        },
                        "Initialize_variable_-_ArgosClosureReason": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "ArgosClosureReason",
                                        "type": "string",
                                        "value": ""
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_variable_-_ArgosStatus": [ "Succeeded" ]
                            }
                        },
                        "Cyberint_Base": {
                            "type": "Workflow",
                            "inputs": {
                                "host": {
                                    "triggerName": "manual",
                                    "workflow": {
                                        "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Logic/workflows/', parameters('Cyberint_Base_Playbook_Name'))]"
                                    }
                                }
                            },
                            "runAfter": {
                                "Initialize_variable_-_ArgosClosureReason": [ "Succeeded" ]
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [ "inputs", "outputs" ]
                                }
                            }
                        },
                        "Compose_labels_string": {
                            "type": "Compose",
                            "inputs": "@string(coalesce(triggerBody()?['object']?['properties']?['labels'], json('[]')))",
                            "runAfter": {
                                "Cyberint_Base": [ "Succeeded" ]
                            }
                        },
                        "Condition_-_Should_sync": {
                            "type": "If",
                            "expression": {
                                "and": [
                                    {
                                        "not": {
                                            "contains": [
                                                "@outputs('Compose_labels_string')",
                                                "argos-inbound-synced"
                                            ]
                                        }
                                    },
                                    {
                                        "contains": [
                                            "@string(coalesce(triggerBody()?['incidentUpdates']?['updatedFields'], json('[]')))",
                                            "Status"
                                        ]
                                    }
                                ]
                            },
                            "actions": {
                                "Compose_classification_mapping": {
                                    "type": "Compose",
                                    "inputs": {
                                        "TruePositive": "true_positive",
                                        "FalsePositive": "false_positive",
                                        "BenignPositive": "benign_positive",
                                        "Undetermined": "undetermined"
                                    },
                                    "runAfter": {}
                                },
                                "Set_ArgosStatus": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "ArgosStatus",
                                        "value": "@if(equals(triggerBody()?['object']?['properties']?['status'], 'Closed'), 'closed', 'open')"
                                    },
                                    "runAfter": {
                                        "Compose_classification_mapping": [ "Succeeded" ]
                                    }
                                },
                                "Set_ArgosClosureReason": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "ArgosClosureReason",
                                        "value": "@if(equals(triggerBody()?['object']?['properties']?['status'], 'Closed'), coalesce(outputs('Compose_classification_mapping')?[triggerBody()?['object']?['properties']?['classification']], 'undetermined'), '')"
                                    },
                                    "runAfter": {
                                        "Set_ArgosStatus": [ "Succeeded" ]
                                    }
                                },
                                "Parse_incident_alerts": {
                                    "type": "Compose",
                                    "inputs": "@triggerBody()?['object']?['properties']?['alerts']",
                                    "runAfter": {
                                        "Set_ArgosClosureReason": [ "Succeeded" ]
                                    }
                                },
                                "For_each_alert": {
                                    "type": "Foreach",
                                    "foreach": "@outputs('Parse_incident_alerts')",
                                    "actions": {
                                        "Set_AlertRefId": {
                                            "type": "SetVariable",
                                            "inputs": {
                                                "name": "AlertRefId",
                                                "value": "@{items('For_each_alert')?['properties']?['additionalData']?['Custom Details']?['ref_id']}"
                                            },
                                            "runAfter": {}
                                        },
                                        "HTTP_-_Update_Argos_alert": {
                                            "type": "Http",
                                            "inputs": {
                                                "method": "PUT",
                                                "uri": "@{body('Cyberint_Base')?['ArgosBaseUrl']}/api/v1/alerts/@{variables('AlertRefId')}",
                                                "headers": {
                                                    "Cookie": "access_token=@{body('Cyberint_Base')?['ArgosApiToken']}",
                                                    "Content-Type": "application/json",
                                                    "Accept": "application/json"
                                                },
                                                "body": {
                                                    "status": "@{variables('ArgosStatus')}",
                                                    "closure_reason": "@{variables('ArgosClosureReason')}"
                                                }
                                            },
                                            "runAfter": {
                                                "Set_AlertRefId": [ "Succeeded" ]
                                            },
                                            "runtimeConfiguration": {
                                                "secureData": {
                                                    "properties": [ "inputs" ]
                                                }
                                            }
                                        },
                                        "Append_sync_result": {
                                            "type": "AppendToStringVariable",
                                            "inputs": {
                                                "name": "SyncResults",
                                                "value": "Alert @{variables('AlertRefId')}: @{variables('ArgosStatus')} (HTTP @{coalesce(outputs('HTTP_-_Update_Argos_alert')?['statusCode'], 'Error')})\n"
                                            },
                                            "runAfter": {
                                                "HTTP_-_Update_Argos_alert": [ "Succeeded", "Failed" ]
                                            }
                                        }
                                    },
                                    "runAfter": {
                                        "Parse_incident_alerts": [ "Succeeded" ]
                                    }
                                },
                                "Add_sync_comment": {
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "body": {
                                            "incidentArmId": "@triggerBody()?['object']?['id']",
                                            "message": "<p><strong>Cyberint Outbound Sync:</strong><br>Sentinel Status: @{triggerBody()?['object']?['properties']?['status']}<br>Argos Status: @{variables('ArgosStatus')}<br>Closure Reason: @{variables('ArgosClosureReason')}<br><br>Results:<br>@{variables('SyncResults')}</p>"
                                        },
                                        "path": "/Incidents/Comment"
                                    },
                                    "runAfter": {
                                        "For_each_alert": [ "Succeeded", "Failed" ]
                                    }
                                },
                                "Update_incident_tags": {
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                            }
                                        },
                                        "method": "put",
                                        "body": {
                                            "incidentArmId": "@triggerBody()?['object']?['id']",
                                            "tagsToAdd": {
                                                "TagsToAdd": [ "argos-outbound-synced" ]
                                            }
                                        },
                                        "path": "/Incidents"
                                    },
                                    "runAfter": {
                                        "Add_sync_comment": [ "Succeeded" ]
                                    }
                                }
                            },
                            "else": {
                                "actions": {}
                            },
                            "runAfter": {
                                "Compose_labels_string": [ "Succeeded" ]
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azuresentinel": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                                "connectionName": "[variables('AzureSentinelConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "outputs": {}
}
{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Cyberint Argos - Phishing Takedown",
        "description": "When a new Microsoft Sentinel incident is created for a phishing website alert, this playbook extracts the phishing URL, evaluates confidence and severity thresholds, submits a takedown request to Cyberint, and tracks the takedown status back to the incident.",
        "prerequisites": [
            "1. Cyberint_Base playbook must be deployed in the same resource group.",
            "2. The Logic App Managed Identity must be granted Microsoft Sentinel Responder role on the resource group."
        ],
        "postDeployment": [
            "1. Grant the Logic App Managed Identity the **Microsoft Sentinel Responder** role.",
            "2. Configure an automation rule in Microsoft Sentinel to trigger this playbook on phishing website incidents."
        ],
        "lastUpdateTime": "2026-02-17T00:00:00.000Z",
        "entities": [ "URL" ],
        "tags": [ "Remediation", "Response" ],
        "support": {
            "tier": "Partner",
            "name": "Cyberint",
            "link": "https://cyberint.com/customer-support/"
        },
        "source": {
            "type": "solution",
            "name": "Check Point Cyberint Alerts"
        },
        "author": {
            "name": "Cyberint"
        },
        "releaseNotes": [
            {
                "version": "1.0.0",
                "title": "Cyberint Argos - Phishing Takedown",
                "notes": [ "Initial version" ]
            }
        ]
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "Cyberint_PhishingTakedown",
            "metadata": {
                "description": "Name of the Logic App / Playbook"
            }
        },
        "Cyberint_Base_Playbook_Name": {
            "type": "string",
            "defaultValue": "Cyberint_Base",
            "metadata": {
                "description": "Name of the Cyberint_Base playbook (must be deployed first)"
            }
        },
        "MinConfidenceForAutoTakedown": {
            "type": "int",
            "defaultValue": 80,
            "metadata": {
                "description": "Minimum confidence score (0-100) from Argos alert to auto-submit takedown request"
            }
        },
        "MinSeverityForAutoTakedown": {
            "type": "string",
            "defaultValue": "high",
            "allowedValues": [ "low", "medium", "high", "very_high" ],
            "metadata": {
                "description": "Minimum Argos alert severity to auto-submit takedown request"
            }
        }
    },
    "variables": {
        "AzureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
        "severityRank": {
            "low": 1,
            "medium": 2,
            "high": 3,
            "very_high": 4
        }
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('AzureSentinelConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('AzureSentinelConnectionName')]",
                "customParameterValues": {},
                "parameterValueType": "Alternative",
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "tags": {
                "hidden-SentinelTemplateName": "Cyberint_PhishingTakedown",
                "hidden-SentinelTemplateVersion": "1.0"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "MinConfidenceForAutoTakedown": {
                            "defaultValue": 80,
                            "type": "Int"
                        },
                        "MinSeverityForAutoTakedown": {
                            "defaultValue": "high",
                            "type": "String"
                        }
                    },
                    "triggers": {
                        "Microsoft_Sentinel_incident": {
                            "type": "ApiConnectionWebhook",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "body": {
                                    "callback_url": "@{listCallbackUrl()}"
                                },
                                "path": "/incident-creation"
                            }
                        }
                    },
                    "actions": {
                        "Cyberint_Base": {
                            "type": "Workflow",
                            "inputs": {
                                "host": {
                                    "triggerName": "manual",
                                    "workflow": {
                                        "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Logic/workflows/', parameters('Cyberint_Base_Playbook_Name'))]"
                                    }
                                }
                            },
                            "runAfter": {},
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [ "inputs", "outputs" ]
                                }
                            }
                        },
                        "Initialize_variable_-_AlertRefId": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "AlertRefId",
                                        "type": "string",
                                        "value": ""
                                    }
                                ]
                            },
                            "runAfter": {
                                "Cyberint_Base": [ "Succeeded" ]
                            }
                        },
                        "Initialize_variable_-_PhishingUrl": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "PhishingUrl",
                                        "type": "string",
                                        "value": ""
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_variable_-_AlertRefId": [ "Succeeded" ]
                            }
                        },
                        "Initialize_variable_-_TakedownStatus": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "TakedownStatus",
                                        "type": "string",
                                        "value": "not_submitted"
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_variable_-_PhishingUrl": [ "Succeeded" ]
                            }
                        },
                        "Parse_incident_alerts": {
                            "type": "Compose",
                            "inputs": "@triggerBody()?['object']?['properties']?['alerts']",
                            "runAfter": {
                                "Initialize_variable_-_TakedownStatus": [ "Succeeded" ]
                            }
                        },
                        "For_each_alert": {
                            "type": "Foreach",
                            "foreach": "@outputs('Parse_incident_alerts')",
                            "actions": {
                                "Set_AlertRefId": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "AlertRefId",
                                        "value": "@{items('For_each_alert')?['properties']?['additionalData']?['Custom Details']?['ref_id']}"
                                    },
                                    "runAfter": {}
                                },
                                "HTTP_-_Get_alert_details": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "@{body('Cyberint_Base')?['ArgosBaseUrl']}/api/v1/alerts/@{variables('AlertRefId')}",
                                        "headers": {
                                            "Cookie": "access_token=@{body('Cyberint_Base')?['ArgosApiToken']}",
                                            "Accept": "application/json"
                                        }
                                    },
                                    "runAfter": {
                                        "Set_AlertRefId": [ "Succeeded" ]
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [ "inputs" ]
                                        }
                                    }
                                },
                                "Set_PhishingUrl": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "PhishingUrl",
                                        "value": "@{body('HTTP_-_Get_alert_details')?['alert_data']?['url']}"
                                    },
                                    "runAfter": {
                                        "HTTP_-_Get_alert_details": [ "Succeeded" ]
                                    }
                                },
                                "Add_enrichment_comment": {
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "body": {
                                            "incidentArmId": "@triggerBody()?['object']?['id']",
                                            "message": "<p><strong>Cyberint Phishing Alert Details:</strong><br>URL: @{body('HTTP_-_Get_alert_details')?['alert_data']?['url']}<br>Title: @{body('HTTP_-_Get_alert_details')?['alert_data']?['title']}<br>A Record: @{body('HTTP_-_Get_alert_details')?['alert_data']?['a_record']}<br>Registrar: @{body('HTTP_-_Get_alert_details')?['alert_data']?['registrar']}<br>Has Password Field: @{body('HTTP_-_Get_alert_details')?['alert_data']?['has_password_field']}<br>Has SSL: @{body('HTTP_-_Get_alert_details')?['alert_data']?['has_ssl_certificate']}<br>Detection Reasons: @{body('HTTP_-_Get_alert_details')?['alert_data']?['detection_reasons']}<br>Confidence: @{body('HTTP_-_Get_alert_details')?['confidence']}<br>Severity: @{body('HTTP_-_Get_alert_details')?['severity']}</p>"
                                        },
                                        "path": "/Incidents/Comment"
                                    },
                                    "runAfter": {
                                        "Set_PhishingUrl": [ "Succeeded" ]
                                    }
                                },
                                "Condition_-_Check_takedown_thresholds": {
                                    "type": "If",
                                    "expression": {
                                        "and": [
                                            {
                                                "greaterOrEquals": [
                                                    "@int(coalesce(body('HTTP_-_Get_alert_details')?['confidence'], '0'))",
                                                    "@parameters('MinConfidenceForAutoTakedown')"
                                                ]
                                            }
                                        ]
                                    },
                                    "actions": {
                                        "HTTP_-_Submit_takedown_request": {
                                            "type": "Http",
                                            "inputs": {
                                                "method": "POST",
                                                "uri": "@{body('Cyberint_Base')?['ArgosBaseUrl']}/api/v1/submit",
                                                "headers": {
                                                    "Cookie": "access_token=@{body('Cyberint_Base')?['ArgosApiToken']}",
                                                    "Content-Type": "application/json",
                                                    "Accept": "application/json"
                                                },
                                                "body": {
                                                    "url": "@{variables('PhishingUrl')}",
                                                    "reason": "@{body('HTTP_-_Get_alert_details')?['alert_data']?['detection_reasons']}",
                                                    "note": "Auto-submitted takedown via Microsoft Sentinel playbook",
                                                    "alert_id": "@{variables('AlertRefId')}"
                                                }
                                            },
                                            "runAfter": {},
                                            "runtimeConfiguration": {
                                                "secureData": {
                                                    "properties": [ "inputs" ]
                                                }
                                            }
                                        },
                                        "Set_TakedownStatus": {
                                            "type": "SetVariable",
                                            "inputs": {
                                                "name": "TakedownStatus",
                                                "value": "@{body('HTTP_-_Submit_takedown_request')?['status']}"
                                            },
                                            "runAfter": {
                                                "HTTP_-_Submit_takedown_request": [ "Succeeded" ]
                                            }
                                        },
                                        "Add_takedown_comment": {
                                            "type": "ApiConnection",
                                            "inputs": {
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                    }
                                                },
                                                "method": "post",
                                                "body": {
                                                    "incidentArmId": "@triggerBody()?['object']?['id']",
                                                    "message": "<p><strong>Cyberint Takedown Request Submitted:</strong><br>URL: @{variables('PhishingUrl')}<br>Status: @{variables('TakedownStatus')}<br>Alert Ref: @{variables('AlertRefId')}</p>"
                                                },
                                                "path": "/Incidents/Comment"
                                            },
                                            "runAfter": {
                                                "Set_TakedownStatus": [ "Succeeded" ]
                                            }
                                        },
                                        "Update_incident_tags": {
                                            "type": "ApiConnection",
                                            "inputs": {
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                    }
                                                },
                                                "method": "put",
                                                "body": {
                                                    "incidentArmId": "@triggerBody()?['object']?['id']",
                                                    "tagsToAdd": {
                                                        "TagsToAdd": [ "takedown-requested" ]
                                                    }
                                                },
                                                "path": "/Incidents"
                                            },
                                            "runAfter": {
                                                "Add_takedown_comment": [ "Succeeded" ]
                                            }
                                        }
                                    },
                                    "else": {
                                        "actions": {
                                            "Add_below_threshold_comment": {
                                                "type": "ApiConnection",
                                                "inputs": {
                                                    "host": {
                                                        "connection": {
                                                            "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                        }
                                                    },
                                                    "method": "post",
                                                    "body": {
                                                        "incidentArmId": "@triggerBody()?['object']?['id']",
                                                        "message": "<p><strong>Cyberint Phishing Takedown:</strong> Alert confidence (@{body('HTTP_-_Get_alert_details')?['confidence']}) is below auto-takedown threshold (@{parameters('MinConfidenceForAutoTakedown')}). Manual review recommended.</p>"
                                                    },
                                                    "path": "/Incidents/Comment"
                                                },
                                                "runAfter": {}
                                            }
                                        }
                                    },
                                    "runAfter": {
                                        "Add_enrichment_comment": [ "Succeeded" ]
                                    }
                                }
                            },
                            "runAfter": {
                                "Parse_incident_alerts": [ "Succeeded" ]
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azuresentinel": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                                "connectionName": "[variables('AzureSentinelConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    },
                    "MinConfidenceForAutoTakedown": {
                        "value": "[parameters('MinConfidenceForAutoTakedown')]"
                    },
                    "MinSeverityForAutoTakedown": {
                        "value": "[parameters('MinSeverityForAutoTakedown')]"
                    }
                }
            }
        }
    ],
    "outputs": {}
}
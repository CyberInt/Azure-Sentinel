{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Cyberint Argos - Credential Leak Validation and Response",
        "description": "When a new Microsoft Sentinel incident is created for leaked credentials, this playbook queries the Cyberint credential leak API for the affected domain, enriches the incident with exposed credential details, and adds results as an incident comment.",
        "prerequisites": [
            "1. Cyberint_Base playbook must be deployed in the same resource group.",
            "2. The Logic App Managed Identity must be granted Microsoft Sentinel Responder role on the resource group."
        ],
        "postDeployment": [
            "1. Grant the Logic App Managed Identity the **Microsoft Sentinel Responder** role.",
            "2. Configure an automation rule in Microsoft Sentinel to trigger this playbook on credential leak incidents."
        ],
        "lastUpdateTime": "2026-02-17T00:00:00.000Z",
        "entities": [ "Account" ],
        "tags": [ "Enrichment", "Response" ],
        "support": {
            "tier": "Partner",
            "name": "Cyberint",
            "link": "https://cyberint.com/customer-support/"
        },
        "source": {
            "type": "solution",
            "name": "Check Point Cyberint Alerts"
        },
        "author": {
            "name": "Cyberint"
        },
        "releaseNotes": [
            {
                "version": "1.0.0",
                "title": "Cyberint Argos - Credential Leak Validation and Response",
                "notes": [ "Initial version" ]
            }
        ]
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "Cyberint_CredentialLeakResponse",
            "metadata": {
                "description": "Name of the Logic App / Playbook"
            }
        },
        "Cyberint_Base_Playbook_Name": {
            "type": "string",
            "defaultValue": "Cyberint_Base",
            "metadata": {
                "description": "Name of the Cyberint_Base playbook (must be deployed first)"
            }
        },
        "CompanyDomain": {
            "type": "string",
            "metadata": {
                "description": "Primary company domain to check for leaked credentials (e.g. example.com)"
            }
        }
    },
    "variables": {
        "AzureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('AzureSentinelConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('AzureSentinelConnectionName')]",
                "customParameterValues": {},
                "parameterValueType": "Alternative",
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "tags": {
                "hidden-SentinelTemplateName": "Cyberint_CredentialLeakResponse",
                "hidden-SentinelTemplateVersion": "1.0"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "CompanyDomain": {
                            "defaultValue": "",
                            "type": "String"
                        }
                    },
                    "triggers": {
                        "Microsoft_Sentinel_incident": {
                            "type": "ApiConnectionWebhook",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "body": {
                                    "callback_url": "@{listCallbackUrl()}"
                                },
                                "path": "/incident-creation"
                            }
                        }
                    },
                    "actions": {
                        "Cyberint_Base": {
                            "type": "Workflow",
                            "inputs": {
                                "host": {
                                    "triggerName": "manual",
                                    "workflow": {
                                        "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Logic/workflows/', parameters('Cyberint_Base_Playbook_Name'))]"
                                    }
                                }
                            },
                            "runAfter": {},
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [ "inputs", "outputs" ]
                                }
                            }
                        },
                        "Entities_-_Get_Accounts": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                                "path": "/entities/account"
                            },
                            "runAfter": {}
                        },
                        "Initialize_variable_-_LeakComment": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "LeakComment",
                                        "type": "string",
                                        "value": ""
                                    }
                                ]
                            },
                            "runAfter": {
                                "Cyberint_Base": [ "Succeeded" ],
                                "Entities_-_Get_Accounts": [ "Succeeded" ]
                            }
                        },
                        "Initialize_variable_-_LeakCount": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "LeakCount",
                                        "type": "integer",
                                        "value": 0
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_variable_-_LeakComment": [ "Succeeded" ]
                            }
                        },
                        "HTTP_-_Query_leaked_credentials_by_domain": {
                            "type": "Http",
                            "inputs": {
                                "method": "POST",
                                "uri": "@{body('Cyberint_Base')?['ArgosBaseUrl']}/by_domain/",
                                "headers": {
                                    "Cookie": "access_token=@{body('Cyberint_Base')?['ArgosApiToken']}",
                                    "Content-Type": "application/json",
                                    "Accept": "application/json"
                                },
                                "body": {
                                    "domain": "@{parameters('CompanyDomain')}"
                                }
                            },
                            "runAfter": {
                                "Initialize_variable_-_LeakCount": [ "Succeeded" ]
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [ "inputs" ]
                                }
                            }
                        },
                        "Parse_JSON_-_Leak_results": {
                            "type": "ParseJson",
                            "inputs": {
                                "content": "@body('HTTP_-_Query_leaked_credentials_by_domain')",
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "credentials": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "email": { "type": "string" },
                                                    "password": { "type": "string" },
                                                    "source": { "type": "string" },
                                                    "last_seen": { "type": "string" }
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "runAfter": {
                                "HTTP_-_Query_leaked_credentials_by_domain": [ "Succeeded" ]
                            }
                        },
                        "For_each_leaked_credential": {
                            "type": "Foreach",
                            "foreach": "@body('Parse_JSON_-_Leak_results')?['credentials']",
                            "actions": {
                                "Increment_LeakCount": {
                                    "type": "IncrementVariable",
                                    "inputs": {
                                        "name": "LeakCount",
                                        "value": 1
                                    },
                                    "runAfter": {}
                                },
                                "Append_leak_detail": {
                                    "type": "AppendToStringVariable",
                                    "inputs": {
                                        "name": "LeakComment",
                                        "value": "<br>• <strong>@{items('For_each_leaked_credential')?['email']}</strong> — Source: @{items('For_each_leaked_credential')?['source']} | Last Seen: @{items('For_each_leaked_credential')?['last_seen']}"
                                    },
                                    "runAfter": {
                                        "Increment_LeakCount": [ "Succeeded" ]
                                    }
                                }
                            },
                            "runAfter": {
                                "Parse_JSON_-_Leak_results": [ "Succeeded" ]
                            }
                        },
                        "Add_comment_to_incident": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": {
                                    "incidentArmId": "@triggerBody()?['object']?['id']",
                                    "message": "<p><strong>Cyberint Credential Leak Results for @{parameters('CompanyDomain')}:</strong><br>Total exposed credentials found: @{variables('LeakCount')}@{variables('LeakComment')}</p>"
                                },
                                "path": "/Incidents/Comment"
                            },
                            "runAfter": {
                                "For_each_leaked_credential": [ "Succeeded" ]
                            }
                        },
                        "Condition_-_High_leak_count": {
                            "type": "If",
                            "expression": {
                                "and": [
                                    {
                                        "greater": [
                                            "@variables('LeakCount')",
                                            10
                                        ]
                                    }
                                ]
                            },
                            "actions": {
                                "Update_incident_severity": {
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                            }
                                        },
                                        "method": "put",
                                        "body": {
                                            "incidentArmId": "@triggerBody()?['object']?['id']",
                                            "severity": "High",
                                            "tagsToAdd": {
                                                "TagsToAdd": [ "credential-leak-high-volume" ]
                                            }
                                        },
                                        "path": "/Incidents"
                                    },
                                    "runAfter": {}
                                }
                            },
                            "runAfter": {
                                "Add_comment_to_incident": [ "Succeeded" ]
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azuresentinel": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                                "connectionName": "[variables('AzureSentinelConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    },
                    "CompanyDomain": {
                        "value": "[parameters('CompanyDomain')]"
                    }
                }
            }
        }
    ],
    "outputs": {}
}
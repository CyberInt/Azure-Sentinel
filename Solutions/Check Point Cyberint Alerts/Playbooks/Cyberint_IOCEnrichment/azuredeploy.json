{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Cyberint Argos - IOC Enrichment and Triage",
        "description": "When a new Microsoft Sentinel incident is created, this playbook enriches IOC entities (IPs, domains, file hashes, URLs) using the Cyberint threat intelligence API and adds enrichment results as an incident comment.",
        "prerequisites": [
            "1. Cyberint_Base playbook must be deployed in the same resource group.",
            "2. The Logic App Managed Identity must be granted Microsoft Sentinel Responder role on the resource group."
        ],
        "postDeployment": [
            "1. Grant the Logic App Managed Identity the **Microsoft Sentinel Responder** role.",
            "2. Configure an automation rule in Microsoft Sentinel to trigger this playbook on incident creation."
        ],
        "lastUpdateTime": "2026-02-17T00:00:00.000Z",
        "entities": [ "IP", "FileHash", "DNS", "URL" ],
        "tags": [ "Enrichment" ],
        "support": {
            "tier": "Partner",
            "name": "Cyberint",
            "link": "https://cyberint.com/customer-support/"
        },
        "source": {
            "type": "solution",
            "name": "Check Point Cyberint Alerts"
        },
        "author": {
            "name": "Cyberint"
        },
        "releaseNotes": [
            {
                "version": "1.0.0",
                "title": "Cyberint Argos - IOC Enrichment and Triage",
                "notes": [ "Initial version" ]
            }
        ]
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "Cyberint_IOCEnrichment",
            "metadata": {
                "description": "Name of the Logic App / Playbook"
            }
        },
        "Cyberint_Base_Playbook_Name": {
            "type": "string",
            "defaultValue": "Cyberint_Base",
            "metadata": {
                "description": "Name of the Cyberint_Base playbook (must be deployed first)"
            }
        }
    },
    "variables": {
        "AzureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('AzureSentinelConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('AzureSentinelConnectionName')]",
                "customParameterValues": {},
                "parameterValueType": "Alternative",
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "tags": {
                "hidden-SentinelTemplateName": "Cyberint_IOCEnrichment",
                "hidden-SentinelTemplateVersion": "1.0"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        }
                    },
                    "triggers": {
                        "Microsoft_Sentinel_incident": {
                            "type": "ApiConnectionWebhook",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "body": {
                                    "callback_url": "@{listCallbackUrl()}"
                                },
                                "path": "/incident-creation"
                            }
                        }
                    },
                    "actions": {
                        "Cyberint_Base": {
                            "type": "Workflow",
                            "inputs": {
                                "host": {
                                    "triggerName": "manual",
                                    "workflow": {
                                        "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Logic/workflows/', parameters('Cyberint_Base_Playbook_Name'))]"
                                    }
                                }
                            },
                            "runAfter": {},
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [ "inputs", "outputs" ]
                                }
                            }
                        },
                        "Entities_-_Get_IPs": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                                "path": "/entities/ip"
                            },
                            "runAfter": {}
                        },
                        "Entities_-_Get_FileHashes": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                                "path": "/entities/filehash"
                            },
                            "runAfter": {}
                        },
                        "Entities_-_Get_DNS": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                                "path": "/entities/dnsresolution"
                            },
                            "runAfter": {}
                        },
                        "Entities_-_Get_URLs": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                                "path": "/entities/url"
                            },
                            "runAfter": {}
                        },
                        "Initialize_variable_-_EnrichmentComment": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "EnrichmentComment",
                                        "type": "string",
                                        "value": ""
                                    }
                                ]
                            },
                            "runAfter": {
                                "Cyberint_Base": [ "Succeeded" ],
                                "Entities_-_Get_IPs": [ "Succeeded" ],
                                "Entities_-_Get_FileHashes": [ "Succeeded" ],
                                "Entities_-_Get_DNS": [ "Succeeded" ],
                                "Entities_-_Get_URLs": [ "Succeeded" ]
                            }
                        },
                        "For_each_IP": {
                            "type": "Foreach",
                            "foreach": "@body('Entities_-_Get_IPs')?['IPs']",
                            "actions": {
                                "HTTP_-_Enrich_IP": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "@{body('Cyberint_Base')?['ArgosBaseUrl']}/api/v1/file/ipv4/@{items('For_each_IP')?['Address']}",
                                        "headers": {
                                            "Cookie": "access_token=@{body('Cyberint_Base')?['ArgosApiToken']}",
                                            "Accept": "application/json"
                                        }
                                    },
                                    "runAfter": {},
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [ "inputs" ]
                                        }
                                    }
                                },
                                "Append_IP_result": {
                                    "type": "AppendToStringVariable",
                                    "inputs": {
                                        "name": "EnrichmentComment",
                                        "value": "<br><strong>IP: @{items('For_each_IP')?['Address']}</strong> — Verdict: @{body('HTTP_-_Enrich_IP')?['verdict']} | Confidence: @{body('HTTP_-_Enrich_IP')?['confidence']} | Malware Family: @{body('HTTP_-_Enrich_IP')?['malware_family']} | First Seen: @{body('HTTP_-_Enrich_IP')?['first_seen']}"
                                    },
                                    "runAfter": {
                                        "HTTP_-_Enrich_IP": [ "Succeeded" ]
                                    }
                                }
                            },
                            "runAfter": {
                                "Initialize_variable_-_EnrichmentComment": [ "Succeeded" ]
                            }
                        },
                        "For_each_FileHash": {
                            "type": "Foreach",
                            "foreach": "@body('Entities_-_Get_FileHashes')?['Filehashes']",
                            "actions": {
                                "HTTP_-_Enrich_FileHash": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "@{body('Cyberint_Base')?['ArgosBaseUrl']}/api/v1/file/sha256/@{items('For_each_FileHash')?['Value']}",
                                        "headers": {
                                            "Cookie": "access_token=@{body('Cyberint_Base')?['ArgosApiToken']}",
                                            "Accept": "application/json"
                                        }
                                    },
                                    "runAfter": {},
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [ "inputs" ]
                                        }
                                    }
                                },
                                "Append_FileHash_result": {
                                    "type": "AppendToStringVariable",
                                    "inputs": {
                                        "name": "EnrichmentComment",
                                        "value": "<br><strong>Hash: @{items('For_each_FileHash')?['Value']}</strong> — Verdict: @{body('HTTP_-_Enrich_FileHash')?['verdict']} | Confidence: @{body('HTTP_-_Enrich_FileHash')?['confidence']} | Malware Family: @{body('HTTP_-_Enrich_FileHash')?['malware_family']} | Actor: @{body('HTTP_-_Enrich_FileHash')?['actor_attribution']}"
                                    },
                                    "runAfter": {
                                        "HTTP_-_Enrich_FileHash": [ "Succeeded" ]
                                    }
                                }
                            },
                            "runAfter": {
                                "For_each_IP": [ "Succeeded" ]
                            }
                        },
                        "For_each_Domain": {
                            "type": "Foreach",
                            "foreach": "@body('Entities_-_Get_DNS')?['DNSresolutions']",
                            "actions": {
                                "HTTP_-_Enrich_Domain": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "@{body('Cyberint_Base')?['ArgosBaseUrl']}/api/v1/file/domain/@{items('For_each_Domain')?['DomainName']}",
                                        "headers": {
                                            "Cookie": "access_token=@{body('Cyberint_Base')?['ArgosApiToken']}",
                                            "Accept": "application/json"
                                        }
                                    },
                                    "runAfter": {},
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [ "inputs" ]
                                        }
                                    }
                                },
                                "Append_Domain_result": {
                                    "type": "AppendToStringVariable",
                                    "inputs": {
                                        "name": "EnrichmentComment",
                                        "value": "<br><strong>Domain: @{items('For_each_Domain')?['DomainName']}</strong> — Verdict: @{body('HTTP_-_Enrich_Domain')?['verdict']} | Confidence: @{body('HTTP_-_Enrich_Domain')?['confidence']} | Malware Family: @{body('HTTP_-_Enrich_Domain')?['malware_family']}"
                                    },
                                    "runAfter": {
                                        "HTTP_-_Enrich_Domain": [ "Succeeded" ]
                                    }
                                }
                            },
                            "runAfter": {
                                "For_each_FileHash": [ "Succeeded" ]
                            }
                        },
                        "For_each_URL": {
                            "type": "Foreach",
                            "foreach": "@body('Entities_-_Get_URLs')?['URLs']",
                            "actions": {
                                "HTTP_-_Enrich_URL": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "@{body('Cyberint_Base')?['ArgosBaseUrl']}/api/v1/file/url?value=@{encodeUriComponent(items('For_each_URL')?['Url'])}",
                                        "headers": {
                                            "Cookie": "access_token=@{body('Cyberint_Base')?['ArgosApiToken']}",
                                            "Accept": "application/json"
                                        }
                                    },
                                    "runAfter": {},
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [ "inputs" ]
                                        }
                                    }
                                },
                                "Append_URL_result": {
                                    "type": "AppendToStringVariable",
                                    "inputs": {
                                        "name": "EnrichmentComment",
                                        "value": "<br><strong>URL: @{items('For_each_URL')?['Url']}</strong> — Verdict: @{body('HTTP_-_Enrich_URL')?['verdict']} | Confidence: @{body('HTTP_-_Enrich_URL')?['confidence']} | Malware Family: @{body('HTTP_-_Enrich_URL')?['malware_family']}"
                                    },
                                    "runAfter": {
                                        "HTTP_-_Enrich_URL": [ "Succeeded" ]
                                    }
                                }
                            },
                            "runAfter": {
                                "For_each_Domain": [ "Succeeded" ]
                            }
                        },
                        "Add_comment_to_incident": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": {
                                    "incidentArmId": "@triggerBody()?['object']?['id']",
                                    "message": "<p><strong>Cyberint IOC Enrichment Results:</strong><br>@{variables('EnrichmentComment')}</p>"
                                },
                                "path": "/Incidents/Comment"
                            },
                            "runAfter": {
                                "For_each_URL": [ "Succeeded" ]
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azuresentinel": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                                "connectionName": "[variables('AzureSentinelConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "outputs": {}
}